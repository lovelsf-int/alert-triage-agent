# DeepSeek V4: structured alert assessment
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_TOKENS=2500

# Alibaba Cloud Model Studio: query/document embeddings
DASHSCOPE_API_KEY=replace-me
DASHSCOPE_EMBEDDING_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10

# PostgreSQL + pgvector + LangGraph checkpointing
DATABASE_URL=postgresql://alert_agent:alert_agent@localhost:5432/alert_agent
DB_MIN_POOL_SIZE=1
DB_MAX_POOL_SIZE=10
KNOWLEDGE_TABLE=langgraph_alert_knowledge

# RAG and governance
RAG_SIMILARITY_THRESHOLD=0.35
MAX_HISTORICAL_CASES=3
MAX_POLICY_RULES=3
HUMAN_REVIEW_THRESHOLD=0.85
RAG_SEED_ON_STARTUP=true

# API
SERVER_HOST=0.0.0.0
SERVER_PORT=8081
LOG_LEVEL=INFO

# Restrict LangGraph checkpoint deserialization
LANGGRAPH_STRICT_MSGPACK=true

# DeepSeek: chat/reasoning model
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_COMPLETIONS_PATH=/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_TOKENS=2500

# Alibaba Cloud Model Studio: embedding model
AI_DASHSCOPE_API_KEY=replace-me
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# PostgreSQL + pgvector
PGHOST=localhost
PGPORT=5432
PGDATABASE=alert_agent
PGUSER=alert_agent
PGPASSWORD=alert_agent

# Elasticsearch: durable asynchronous analysis job state
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_CONNECTION_TIMEOUT=3s
ELASTICSEARCH_SOCKET_TIMEOUT=30s
ES_JAVA_OPTS=-Xms512m -Xmx512m

# Virtual-thread AI analysis controls
ALERT_ANALYSIS_MAX_IN_FLIGHT=64
ALERT_ANALYSIS_LEASE=90s
ALERT_ANALYSIS_MAX_ATTEMPTS=5
ALERT_ANALYSIS_BASE_RETRY_DELAY=2s
ALERT_ANALYSIS_MAX_RETRY_DELAY=5m
ALERT_ANALYSIS_RECOVERY_BATCH_SIZE=200
ALERT_ANALYSIS_RECOVERY_INTERVAL_MS=5000
ALERT_ANALYSIS_OPTIMISTIC_RETRIES=5

# Agent and RAG governance
ALERT_AGENT_ENGINE=react-agent
HUMAN_REVIEW_THRESHOLD=0.85
MAX_HISTORICAL_CASES=3
MAX_POLICY_RULES=3
RAG_SIMILARITY_THRESHOLD=0.35
RAG_INGEST_BATCH_SIZE=10
RAG_SEED_ON_STARTUP=true
